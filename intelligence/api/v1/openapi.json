{
  "openapi": "3.1.0",
  "info": {
    "title": "Freedom 250 Shared Brain API",
    "version": "1.0.0",
    "description": "Static read-only research retrieval API. It provides stable files rather than server-side search or mutation."
  },
  "servers": [
    {
      "url": "https://katiekaim-sudo.github.io/freedom250-chronicle/intelligence/api/v1"
    }
  ],
  "paths": {
    "/index.json": {
      "get": {
        "operationId": "getSharedBrainBootstrap",
        "summary": "Get method, custody, retrieval order and endpoint map",
        "responses": {
          "200": {
            "description": "Bootstrap context",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/packages.json": {
      "get": {
        "operationId": "listResearchPackages",
        "summary": "List compact package records for first-hop selection",
        "responses": {
          "200": {
            "description": "Package index",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/packages/{research_id}.json": {
      "get": {
        "operationId": "getResearchPackage",
        "summary": "Get one package manifest and complete governed material inventory",
        "parameters": [
          {
            "name": "research_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Package manifest",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Unknown package"
          }
        }
      }
    },
    "/package-inventory.json": {
      "get": {
        "operationId": "getPackageInteriorInventory",
        "summary": "List every package and group its materials by research function",
        "responses": {
          "200": {
            "description": "Package interior inventory",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/materials.json": {
      "get": {
        "operationId": "listAllMaterials",
        "summary": "List all material memberships, including safe metadata-only one-offs",
        "responses": {
          "200": {
            "description": "JSON material array",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/materials.jsonl": {
      "get": {
        "operationId": "streamAllMaterials",
        "summary": "Read the optional newline-delimited material stream",
        "responses": {
          "200": {
            "description": "JSONL bytes served by GitHub Pages",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/inventory.json": {
      "get": {
        "operationId": "getResearchInventory",
        "summary": "Get the layered computer-side inventory and package recency map",
        "responses": {
          "200": {
            "description": "Layered inventory",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/activity.json": {
      "get": {
        "operationId": "listResearchActivity",
        "summary": "List deduplicated materials sorted by privacy-safe filesystem modification time",
        "responses": {
          "200": {
            "description": "JSON activity array",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/activity.jsonl": {
      "get": {
        "operationId": "streamResearchActivity",
        "summary": "Read the optional newline-delimited activity stream",
        "responses": {
          "200": {
            "description": "JSONL bytes served by GitHub Pages",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/data/{data_id}.json": {
      "get": {
        "operationId": "getPublicMachineData",
        "summary": "Get one complete positively selected structured research dataset",
        "parameters": [
          {
            "name": "data_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Structured research dataset; preserve its schema, as-of date, vocabulary and scope boundary",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Unknown or non-public dataset"
          }
        }
      }
    }
  },
  "externalDocs": {
    "description": "Human instructions for Katie's bots",
    "url": "https://katiekaim-sudo.github.io/freedom250-chronicle/intelligence/for-katies-bot.html"
  }
}
